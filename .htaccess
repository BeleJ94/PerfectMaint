# Si le vhost pointe sur la racine du projet (au lieu de /public), on redirige tout vers /public
# et on bloque l'accès aux dossiers sensibles (app, config, vendor, .env…).
Options -Indexes
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteRule ^(app|bin|config|database|lang|storage|tests|vendor|node_modules)(/|$) - [F,L]
    RewriteRule ^\. - [F,L]
    RewriteRule ^(composer\.(json|lock)|package\.json|phpunit\.xml)$ - [F,L]
    RewriteRule ^$ public/ [L]
    RewriteRule ^(?!public/)(.*)$ public/$1 [L]
</IfModule>
