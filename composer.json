{
    "name": "perfect-logistics/perfectmaint",
    "description": "PerfectMaint - GMAO multi-sites pour Perfect Logistics",
    "type": "project",
    "license": "proprietary",
    "require": {
        "php": ">=8.2",
        "ext-pdo": "*",
        "ext-pdo_mysql": "*",
        "ext-mbstring": "*",
        "ext-json": "*"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.5"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/"
        },
        "files": [
            "app/Core/helpers.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/php/"
        }
    },
    "scripts": {
        "test": [
            "phpunit",
            "npm test --silent"
        ],
        "test:php": "phpunit",
        "test:js": "npm test --silent",
        "migrate": "php bin/migrate.php",
        "seed": "php bin/seed.php",
        "serve": [
            "Composer\\Config::disableProcessTimeout",
            "php -S 127.0.0.1:8080 -t public bin/dev-router.php"
        ],
        "assets": "bash bin/fetch-vendor-assets.sh"
    },
    "config": {
        "sort-packages": true
    }
}
