# Copier en .env et adapter
APP_ENV=local
APP_DEBUG=true
# Sous-répertoire d'URL si l'app n'est pas servie à la racine du vhost (ex. /perfectmaint)
APP_BASE_PATH=
SESSION_SECURE=false
# Devise des coûts : USD (défaut), CDF, EUR…
APP_CURRENCY=USD
# Fuseau horaire des sites (dates affichées et enregistrées)
APP_TIMEZONE=Africa/Lubumbashi

DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=perfectmaint
DB_USER=perfectmaint
DB_PASS=
